# Copy to .env and fill in real values. .env is gitignored — never commit it.
# DATABASE_URL variants seen in this repo use both socket and remote forms;
# the pool uses this value directly (Prisma 7 driver adapter + pg).

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/expaura"

# Max pg connection pool size (optional; default used if unset)
DATABASE_POOL_MAX="10"

# HS256 signing key for the jose JWT session cookie (expaura_session)
JWT_SECRET="change-me-to-a-long-random-string"

# Public site URL, used in emails and links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary image uploads (signed REST uploads via @/lib/upload)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Brevo transactional email (@/lib/email/brevo)
BREVO_API_KEY="your-brevo-api-key"
BREVO_SENDER_EMAIL="noreply@example.com"
BREVO_SENDER_NAME="Expaura"

# NOTE: NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET is present in some .env files
# but is NOT referenced by the app — do not build on it.